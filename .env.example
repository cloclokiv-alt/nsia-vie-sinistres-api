APP_NAME="NSIA Vie — Sinistres"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# L'API parle français ; les dates sont stockées et renvoyées en UTC (ISO 8601),
# les clients les affichent à l'heure de Brazzaville (UTC+1).
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de données -------------------------------------------------------
# Production : MySQL 8. Pour un essai rapide en local, basculez sur
# DB_CONNECTION=sqlite et créez le fichier database/database.sqlite.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nsia_vie_sinistres
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Authentification des agents (Sanctum) ---------------------------------
# Durée de vie des jetons en minutes. Un poste de guichet reste ouvert la
# journée : 12 heures, pas davantage.
SANCTUM_TOKEN_EXPIRATION=720

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@nsia-vie.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Pièces des dossiers sinistre ------------------------------------------
# Les scans du bureau courrier sont écrits sur le disque « sinistres »
# (storage/app/sinistres), hors du dossier public. Taille maximale par
# fichier, en kilo-octets, et types acceptés au dépôt.
SINISTRES_TAILLE_MAX_KO=10240
SINISTRES_TYPES_ACCEPTES="pdf,jpg,jpeg,png,tiff,heic"
