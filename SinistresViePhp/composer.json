{
    "name": "nsia/sinistres-vie",
    "description": "Sinistres Assurance Vie - transposition Symfony sur SQL Server 2019",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "ext-pdo_sqlsrv": "*",
        "doctrine/doctrine-bundle": "^2.12",
        "doctrine/orm": "^3.2",
        "symfony/console": "^7.1",
        "symfony/dotenv": "^7.1",
        "symfony/form": "^7.1",
        "symfony/framework-bundle": "^7.1",
        "symfony/mailer": "^7.4",
        "symfony/runtime": "^7.1",
        "symfony/security-bundle": "^7.1",
        "symfony/twig-bundle": "^7.1",
        "symfony/validator": "^7.1"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "phpunit/phpunit": "^11.3",
        "symfony/browser-kit": "^7.1",
        "symfony/css-selector": "^7.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        },
        "platform": {
            "php": "8.2.33"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/phpunit",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test"
    }
}
